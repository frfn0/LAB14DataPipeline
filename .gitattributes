# Текст хранится с LF, чтобы диффы не зависели от настроек core.autocrlf
# и чтобы gofmt не ругался на смешанные переносы строк.
*.go   text eol=lf
*.py   text eol=lf
*.md   text eol=lf
*.txt  text eol=lf
*.toml text eol=lf
*.mod  text eol=lf
*.sum  text eol=lf
*.ini  text eol=lf
*.yml  text eol=lf
*.yaml text eol=lf
*.json text eol=lf

# Данные: JSON Lines и Parquet хранятся как есть
*.jsonl text eol=lf
*.parquet binary

# Бинарные файлы
*.exe   binary
*.png   binary
*.html  text eol=lf